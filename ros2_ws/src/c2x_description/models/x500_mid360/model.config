<?xml version="1.0"?>
<model>
  <name>x500_mid360</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    PX4 x500 quadrotor extended with a 3D scanning gpu_lidar approximating a
    Livox Mid-360 (360 deg horizontal x 59 deg vertical FOV), for the
    C2-Explorer ROS2/Gazebo port. Base x500 model from PX4-Autopilot.
  </description>
</model>
