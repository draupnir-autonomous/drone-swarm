<?xml version="1.0"?>

<sdf version="1.6">
  <model name='TrashBin'>
    <static>true</static>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>

        <visual name="visual">
          <geometry>
            <mesh><uri>model://TrashBin/meshes/TrashBin.obj</uri></mesh>
          </geometry>
        </visual>

        <collision name="collision">
          <geometry>
            <mesh><uri>model://TrashBin/meshes/TrashBin.obj</uri></mesh>
          </geometry>
        </collision>
      <!-- INIZIO per_lidar: GENERATO DA scripts/make_parco.py (geometrie_per_lidar) -->
      <!-- La collisione come la deve vedere il lidar: vedi la funzione in make_parco.py. -->
      <visual name="per_lidar">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://TrashBin/meshes/TrashBin_lidar.dae</uri></mesh></geometry>
        <material><diffuse>0.5 0.5 0.5 1</diffuse></material>
        <transparency>1.0</transparency>
      </visual>
      <!-- FINE per_lidar -->

    </link>
  </model>
</sdf>
