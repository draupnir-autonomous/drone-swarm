<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>exploration_manager</name>
  <version>0.0.1</version>
  <description>
    C2-Explorer top-level exploration FSM tying together plan_env,
    active_perception, plan_manage and lkh_mtsp_solver into autonomous
    single-UAV exploration.
  </description>
  <maintainer email="fabiofraschetti99@gmail.com">fabio</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>c2x_msgs</depend>
  <depend>plan_env</depend>
  <depend>path_searching</depend>
  <depend>bspline</depend>
  <depend>bspline_opt</depend>
  <depend>poly_traj</depend>
  <depend>active_perception</depend>
  <depend>traj_utils</depend>
  <depend>plan_manage</depend>
  <depend>lkh_mtsp_solver</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
