<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>c2x_px4_bridge</name>
  <version>0.0.1</version>
  <description>Bridges PX4 (via px4_msgs/uXRCE-DDS) and the ported C2-Explorer exploration stack: odometry (PX4-&gt;ROS2) and PositionCommand-&gt;TrajectorySetpoint (ROS2-&gt;PX4)</description>
  <maintainer email="fabiofraschetti99@gmail.com">fabio</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>px4_ros_com</depend>
  <depend>c2x_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen</depend>
  <depend>rosgraph_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
